<resources>

    <style name="Theme.MindUnload" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash mit warmem Hintergrund und Launcher-Motiv; wechselt danach ins normale Theme. -->
    <style name="Theme.MindUnload.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#F6F4EF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#3E624F</item>
        <item name="postSplashScreenTheme">@style/Theme.MindUnload</item>
    </style>
</resources>
